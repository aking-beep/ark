    "smoke": "node dist/smoke.js"
  },
  "dependencies": {
    "@ark/core": "*",
    "@ark/sdk": "*",
    "@ark/providers": "*",
    "@ark/evals": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.9.0"
  }
}
