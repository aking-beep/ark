{
  "name": "@ark/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "push": "node dist/push.js",
    "seed": "node dist/seed.js",
    "ingest:live": "node dist/live-ingest.js",
    "test": "tsc -p tsconfig.json && node --test dist/ingest.test.js dist/evidence.test.js dist/auth.test.js dist/alerts.test.js dist/session-token.test.js"
  },
  "dependencies": {
    "@ark/core": "*",
    "@ark/protocols": "*",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": { "typescript": "^5.6.0", "@types/node": "^22.9.0" }
}
