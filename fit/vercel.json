{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "services.api.main:app",
      "installCommand": "pip install fastapi 'pydantic>=2.7' uvicorn",
      "functions": {
        "services/api/main.py": {
          "maxDuration": 30,
          "excludeFiles": "{apps/**,node_modules/**,**/.next/**,tests/**,evals/**,.git/**,.venv/**,**/__pycache__/**,.pytest_cache/**,playwright-report/**,test-results/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/v1/:path*", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
