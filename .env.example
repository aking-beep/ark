# Local dev needs none of this — the repo runs zero-config on a local SQLite file.
# Set these only when you move off the local file or turn auth on in production.

# libSQL / Turso / Postgres-compatible URL. Defaults to file:./ark.db
ARK_DATABASE_URL=file:./ark.db
ARK_DATABASE_AUTH_TOKEN=

# Required in NODE_ENV=production. Local default is a documented insecure value.
ARK_SESSION_SECRET=

# Optional legacy ingest token mapped to ARK_ORG_ID. Prefer org_tokens from seed.
ARK_INGEST_TOKEN=
ARK_ORG_ID=org_demo

# Seeded demo identities (local only — change before first seed in anything shared)
ARK_DEMO_EMAIL=dana@riverbend.example
ARK_DEMO_PASSWORD=riverbend-demo
ARK_NORTHWIND_EMAIL=sam@northwind.example
ARK_NORTHWIND_PASSWORD=northwind-demo
ARK_INGEST_TOKEN_DEMO=ark_dev_ingest_org_demo
ARK_INGEST_TOKEN_NORTHWIND=ark_dev_ingest_org_northwind

# Where MY AI for teams reads calibration priors from. Unset = heuristics only (and it will say so).
ARK_CONTROL_URL=http://localhost:3002
# Bearer token matching an org_tokens row. Required once ingest tokens exist.
ARK_CONTROL_TOKEN=ark_dev_ingest_org_demo

# MY AI (consumer) → Python engine. Unset in local Next = http://127.0.0.1:8472. Empty on Vercel (platform rewrite).
API_ORIGIN=http://127.0.0.1:8472

# Optional. If set at seed time, attached as destinations on org_northwind.
ARK_WEBHOOK_URL=
ARK_SLACK_WEBHOOK_URL=

# Local open-weight models via Ollama (Llama, DeepSeek-R1, Qwen, Gemma, SmolLM, …).
# privacy=local-only will not call Bedrock, DeepSeek’s host, or other cloud adapters.
# complete() GETs /api/tags and refuses tags that are not installed.
# Set ARK_OLLAMA_PULL=1 only if you want Ollama to pull missing weights.
ARK_OLLAMA_URL=
ARK_OLLAMA_MODEL=llama3.2
ARK_OLLAMA_PULL=0

# Amazon Bedrock (Converse). Also reads AWS_REGION if ARK_BEDROCK_REGION is unset.
ARK_BEDROCK_REGION=
ARK_BEDROCK_MODEL_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# OpenAI-compatible frontier (any /v1/chat/completions host — Groq, Together, vLLM, DeepSeek).
ARK_FRONTIER_BASE_URL=
ARK_FRONTIER_API_KEY=
ARK_FRONTIER_MODEL=
# Hosted DeepSeek (open-weight). Sets the frontier adapter to https://api.deepseek.com
# unless ARK_FRONTIER_* is already set. Default model: deepseek-chat.
DEEPSEEK_API_KEY=
# Hugging Face Inference Providers (open-weight). Sets the frontier adapter to
# https://router.huggingface.co unless ARK_FRONTIER_* or DEEPSEEK_API_KEY is set.
# Default model: Qwen/Qwen3-8B (most-downloaded Hub instruct checkpoint we can serve).
HF_TOKEN=
# Control already documents ARK_CONTROL_URL / ARK_CONTROL_TOKEN / ARK_ORG_ID above.
# Operators ingesting provider=bedrock should add it to ARK_PROVIDER_ALLOWLIST on Control.
