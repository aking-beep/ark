# Local dev needs none of this — the repo runs zero-config on a local SQLite file.
# Set these only when you move off the local file or turn auth on in production.

# libSQL / Turso / Postgres-compatible URL. Defaults to file:./ark.db
ARK_DATABASE_URL=file:./ark.db
ARK_DATABASE_AUTH_TOKEN=

# Required in NODE_ENV=production. Local default is a documented insecure value.
ARK_SESSION_SECRET=

# Optional legacy ingest token mapped to ARK_ORG_ID. Prefer org_tokens from seed.
ARK_INGEST_TOKEN=
ARK_ORG_ID=org_demo

# Seeded demo identities (local only — change before first seed in anything shared)
ARK_DEMO_EMAIL=dana@riverbend.example
ARK_DEMO_PASSWORD=riverbend-demo
ARK_NORTHWIND_EMAIL=sam@northwind.example
ARK_NORTHWIND_PASSWORD=northwind-demo
ARK_INGEST_TOKEN_DEMO=ark_dev_ingest_org_demo
ARK_INGEST_TOKEN_NORTHWIND=ark_dev_ingest_org_northwind

# Where AIFit reads calibration priors from. Unset = heuristics only (and it will say so).
ARK_CONTROL_URL=http://localhost:3002
# Bearer token matching an org_tokens row. Required once ingest tokens exist.
ARK_CONTROL_TOKEN=ark_dev_ingest_org_demo

# Optional. If set at seed time, attached as destinations on org_northwind.
ARK_WEBHOOK_URL=
ARK_SLACK_WEBHOOK_URL=
