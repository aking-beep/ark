# Local dev needs none of this — the repo runs zero-config on a local SQLite file.
# Set these only when you move off the local file.

# libSQL / Turso / Postgres-compatible URL. Defaults to file:./ark.db
ARK_DATABASE_URL=file:./ark.db
ARK_DATABASE_AUTH_TOKEN=

# Control ingest auth. Any non-empty value enables bearer-token checks on /v1/events.
ARK_INGEST_TOKEN=

# Where AIFit reads calibration priors from. Unset = heuristics only (and it will say so).
ARK_CONTROL_URL=http://localhost:3002
