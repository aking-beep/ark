# Local dev needs none of this — the repo runs zero-config on a local SQLite file.
# Set these only when you move off the local file or turn auth on in production.
#
# WHERE THIS FILE GOES. There is no single root .env: each Next app loads its own
# apps/<app>/.env.local (apps/consumer, apps/business, apps/control), and the
# packages/db scripts (db:push, db:seed, db:bootstrap, ingest:live) read only the
# shell environment. Copy the variables an app needs into that app's .env.local,
# and export the DB/seed ones in your shell before running the npm db scripts.
# Docker reads them from the compose environment instead (deploy/docker-compose.yml).

# libSQL / Turso URL. Unset = file:<repo root>/ark.db, shared by every app.
# If you set a file: URL, make it ABSOLUTE (file:/abs/path/ark.db). A relative
# file:./ark.db resolves against each process's working directory, so Control
# (apps/control) and the seed (packages/db) would silently use different files.
# ARK_DATABASE_URL=file:/absolute/path/to/ark.db
ARK_DATABASE_AUTH_TOKEN=

# Required when NODE_ENV=production: at least 32 characters, and not one of the
# documented placeholders — Control refuses to start otherwise. Generate one:
#   openssl rand -hex 32
# Unset in local dev = a documented insecure development value.
ARK_SESSION_SECRET=

# Optional legacy ingest token. When set, a request bearing it is attributed to
# ARK_ORG_ID (default org_demo). Prefer the per-org org_tokens rows from the seed.
# With no org_tokens rows and no ARK_INGEST_TOKEN, local dev accepts unauthenticated
# ingest ("open mode"); production refuses it.
ARK_INGEST_TOKEN=
# ARK_ORG_ID=org_demo

# Seeded identities and ingest tokens. The local defaults below are public, so:
# with NODE_ENV=production the seed refuses to run on them — set all four
# (passwords and ingest tokens) to your own values. In production the seed also
# refuses to run at all unless ARK_ALLOW_SEED=1. `npm run db:bootstrap` pushes the
# schema and seeds only when the orgs table is empty (the Docker entrypoint runs
# it on every boot with ARK_ALLOW_SEED=1 for that one call); `npm run db:seed`
# re-seeds unconditionally — never point it at a live database.
ARK_DEMO_EMAIL=dana@riverbend.example
ARK_DEMO_PASSWORD=riverbend-demo
ARK_NORTHWIND_EMAIL=sam@northwind.example
ARK_NORTHWIND_PASSWORD=northwind-demo
ARK_INGEST_TOKEN_DEMO=ark_dev_ingest_org_demo
ARK_INGEST_TOKEN_NORTHWIND=ark_dev_ingest_org_northwind
ARK_ALLOW_SEED=

# Control login page shows the demo credentials when NODE_ENV is not production.
# Set to 1 to show them in production too (a deliberate public demo deployment).
ARK_SHOW_DEMO_LOGIN=

# Where MY AI for teams reads calibration priors from. Unset = heuristics only (and it will say so).
# The same pair is what POST /api/measure uses to ingest a synthetic Runtime sample.
ARK_CONTROL_URL=http://localhost:3002
# Bearer token matching an org_tokens row. Required once ingest tokens exist.
# The token decides the org; the request body no longer needs an orgId.
ARK_CONTROL_TOKEN=ark_dev_ingest_org_demo

# AI Fit Teams POST /api/measure (runs a real model call and ingests the sample).
# Off unless set to 1. When on, it is rate-limited per IP and writes only to
# teams_sample_* workload ids.
ARK_MEASURE_ENABLED=

# MY AI (consumer) → Python engine. Unset in local Next = http://127.0.0.1:8472. Empty on Vercel (platform rewrite).
API_ORIGIN=http://127.0.0.1:8472

# Optional. If set at seed time, attached as destinations on org_northwind.
ARK_WEBHOOK_URL=
ARK_SLACK_WEBHOOK_URL=

# Local open-weight models via Ollama (Llama, DeepSeek-R1, Qwen, Gemma, SmolLM, …).
# privacy=local-only will not call Bedrock, DeepSeek’s host, or other cloud adapters.
# complete() GETs /api/tags and refuses tags that are not installed.
# POST /api/measure uses this tag for the synthetic sample — not the catalog
# estimate id (local-70b). Set it to a tag `ollama list` actually shows.
# Set ARK_OLLAMA_PULL=1 only if you want Ollama to pull missing weights.
ARK_OLLAMA_URL=
ARK_OLLAMA_MODEL=llama3.2
ARK_OLLAMA_PULL=0

# Amazon Bedrock (Converse). Also reads AWS_REGION if ARK_BEDROCK_REGION is unset.
ARK_BEDROCK_REGION=
ARK_BEDROCK_MODEL_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# OpenAI-compatible frontier (any /v1/chat/completions host — Groq, Together, vLLM, DeepSeek).
ARK_FRONTIER_BASE_URL=
ARK_FRONTIER_API_KEY=
ARK_FRONTIER_MODEL=
# Hosted DeepSeek (open-weight). Sets the frontier adapter to https://api.deepseek.com
# unless ARK_FRONTIER_* is already set. Default model: deepseek-chat.
DEEPSEEK_API_KEY=
# Hugging Face Inference Providers (open-weight). Sets the frontier adapter to
# https://router.huggingface.co unless ARK_FRONTIER_* or DEEPSEEK_API_KEY is set.
# Default model: Qwen/Qwen3-8B (most-downloaded Hub instruct checkpoint we can serve).
HF_TOKEN=
# Control already documents ARK_CONTROL_URL / ARK_CONTROL_TOKEN / ARK_ORG_ID above.
# Operators ingesting provider=bedrock should add it to ARK_PROVIDER_ALLOWLIST on Control.

# Optional. Server-side only. Never expose as NEXT_PUBLIC_ARK_GITHUB_TOKEN.
# Required for private GitHub repositories on Control /discover, or for higher API rate limits.
# Public repositories work without it. The token is not sent to the browser and is not stored.
ARK_GITHUB_TOKEN=
# Because ARK_GITHUB_TOKEN is one server-wide token, /discover only scans repos
# that GitHub reports as public unless this is set to 1 (single-tenant installs
# where every Control user may read every repo the token can).
ARK_DISCOVER_ALLOW_PRIVATE=

# Proxies in front of the Next apps (default 1). Rate limits key on the
# X-Forwarded-For entry this many places from the right.
ARK_TRUSTED_PROXY_HOPS=
