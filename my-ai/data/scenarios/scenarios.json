          },
          {
            "id": "b",
            "label": "Have the AI write the go-live recommendation and own the call.",
            "events": [
              {
                "event_type": "delegated_action",
                "strength": 0.9
              },
              {
                "event_type": "requested_recommendation",
                "strength": 0.8
              }
            ]
          },
          {
            "id": "c",
            "label": "Ask for a concise briefing only: decision, risk, and one backup.",
            "events": [
              {
                "event_type": "requested_summary",
                "strength": 1.0
              },
              {
                "event_type": "requested_recommendation",
                "strength": 0.6
              }
            ]
          }
        ]
      },
      {
        "id": "lr-3",
        "prompt": "Someone wants a shared tracker standing up in an hour. How do you staff the work?",
        "allow_free_text": true,
        "choices": [
          {
            "id": "a",
            "label": "Connect it to the existing tracker and chat stack rather than a one-off doc.",
