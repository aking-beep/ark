[
  {
    "id": "launch-risk",
    "title": "Going live Friday",
    "domain": "decision",
    "setup": "Your shop, site, or product goes live Friday. One person says it is ready. Someone else spotted a possible problem. You already told people the date.",
    "initial_ambiguity": "You do not yet know how serious it is, or what 'ready' means.",
    "dimensions": [
      "evidence_seeking",
      "clarification_tendency",
      "recommendation_preference",
      "depth_preference"
    ],
    "rounds": 3,
    "turns": [
      {
        "id": "lr-1",
        "prompt": "People want an answer in ten minutes. What do you have the AI do first?",
        "hidden_information": "Severity and exploitability have not been established.",
        "allow_free_text": true,
        "choices": [
          {
            "id": "a",
            "label": "Find out how bad it is and what 'ready' actually means before anyone picks a path.",
            "events": [
              {
                "event_type": "requested_evidence",
                "strength": 1.0
              },
              {
                "event_type": "asked_clarification",
                "strength": 0.8
              }
            ]
          },
          {
            "id": "b",
            "label": "Just recommend go / wait / patch now so the conversation has a decision.",
            "events": [
              {
                "event_type": "requested_recommendation",
                "strength": 1.0
              },
              {
                "event_type": "chose_fast_path",
                "strength": 0.9
              }
            ]
          },
          {
            "id": "c",
            "label": "Compare waiting vs. going live with a patch vs. having a backup plan.",
            "events": [
              {
                "event_type": "requested_comparison",
                "strength": 1.0
              },
              {
                "event_type": "chose_deep_path",
                "strength": 0.7
              }
            ]
          }
        ]
      },
      {
        "id": "lr-2",
        "prompt": "One person still says 'ready.' Another still flags a possible problem. Next move?",
